<?xml version="1.0"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- 主标题 -->
    <sys:String x:Key="LOCFriendlySetPlayTimeSetPlayTimeTo">设置游玩时间为：</sys:String>
    <sys:String x:Key="LOCFriendlySetPlayTimeAlwaysEnabledTooltip">始终启用。</sys:String>

    <!-- 时间单位标签 -->
    <sys:String x:Key="LOCFriendlySetPlayTimeDaysLabel">天：</sys:String>
    <sys:String x:Key="LOCFriendlySetPlayTimeHoursLabel">小时：</sys:String>
    <sys:String x:Key="LOCFriendlySetPlayTimeMinutesLabel">分钟：</sys:String>
    <sys:String x:Key="LOCFriendlySetPlayTimeSecondsLabel">秒：</sys:String>

    <!-- 完成状态 -->
    <sys:String x:Key="LOCFriendlySetPlayTimeSetCompletionStatusTo">设置完成状态为：</sys:String>
    <sys:String x:Key="LOCFriendlySetPlayTimeCompletionStatusTooltip">取消勾选以保持当前完成状态。</sys:String>

    <!-- 最后活动时间 -->
    <sys:String x:Key="LOCFriendlySetPlayTimeSetLastActivityTo">设置最后活动时间为：</sys:String>
    <sys:String x:Key="LOCFriendlySetPlayTimeLastActivityTooltip">取消勾选以保持当前最后活动时间。</sys:String>
    <sys:String x:Key="LOCFriendlySetPlayTimeToday">今天</sys:String>
    <sys:String x:Key="LOCFriendlySetPlayTimeSelectedDate">选择日期：</sys:String>

    <!-- 按钮 -->
    <sys:String x:Key="LOCFriendlySetPlayTimeSave">保存</sys:String>
    <sys:String x:Key="LOCFriendlySetPlayTimeCancel">取消</sys:String>

</ResourceDictionary>